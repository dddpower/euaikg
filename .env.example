# Neo4j
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Google Gemini API
GOOGLE_API_KEY=

# vLLM server
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL_ID=Qwen/Qwen3-14B-AWQ

# Document
DOCUMENT_PATH=EU_ai.txt

# Chunking
CHUNK_SIZE=350
CHUNK_OVERLAP=75

# Processing
MAX_WORKERS=4
EXTRACTION_TIMEOUT=300

# Cache
GRAPH_CACHE_DIR=./graph_cache_hybrid

# Embedding
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DEVICE=cuda
EMBEDDING_CACHE_DIR=./local_transformers

# Community detection
SIMILARITY_THRESHOLD=0.95
WORD_EDIT_DISTANCE=3

# Gemini models
GEMINI_EXTRACTION_MODEL=gemini-2.5-pro
GEMINI_RESOLUTION_MODEL=gemini-2.5-pro
