digraph Extraction {
    rankdir=LR;
    bgcolor="white";
    ratio="compress";
    size="12,5";
    node [fontname="Helvetica", fontsize=10, style="filled,rounded", shape=box, penwidth=1.2, margin="0.12,0.06"];
    edge [fontname="Helvetica", fontsize=9, color="#555555", penwidth=1.2];

    // ── Input ──
    chunks [label="Text\nChunks", fillcolor="#E8F5E9", color="#43A047", shape=note];

    // ── Transformer ──
    transformer [label="LLMGraphTransformer\nproperties: [description]", fillcolor="#E3F2FD", color="#1E88E5"];

    // ── Dual LLM ──
    subgraph cluster_dual {
        label="Dual LLM Strategy";
        fontname="Helvetica Bold";
        fontsize=10;
        style="dashed,rounded";
        color="#7E57C2";
        bgcolor="#F3E5F5";
        margin=12;

        vllm [label="vLLM (Qwen3-14B)\n4 threads / 300s", fillcolor="#CE93D8", color="#7E57C2"];
        gemini [label="Gemini API\n(fallback)", fillcolor="#E1BEE7", color="#7E57C2"];
        vllm -> gemini [label="fail", style=dashed, color="#E53935"];
    }

    // ── Serialization ──
    graphdoc [label="GraphDocument\n(pickle/JSONL)", fillcolor="#FFF9C4", color="#F9A825", shape=cylinder];

    // ── Neo4j ──
    neo4j [label="Neo4j\nadd_graph_documents()", fillcolor="#E0F2F1", color="#00897B"];

    // ── Result nodes ──
    subgraph cluster_result {
        label="Neo4j Graph";
        fontname="Helvetica Bold";
        fontsize=10;
        style="dashed,rounded";
        color="#00897B";
        bgcolor="#E0F2F1";
        margin=12;

        entity [label="__Entity__\n(id, desc)", fillcolor="#80CBC4", color="#00897B"];
        rels [label="Relations\n(REGULATES, ...)", fillcolor="#80CBC4", color="#00897B"];
        mentions [label="MENTIONS\n(source ref)", fillcolor="#80CBC4", color="#00897B"];
    }

    // ── Edges ──
    chunks -> transformer;
    transformer -> vllm;
    vllm -> graphdoc;
    gemini -> graphdoc;
    graphdoc -> neo4j;
    neo4j -> entity;
    neo4j -> rels;
    neo4j -> mentions;
}
