digraph Community {
    rankdir=LR;
    bgcolor="white";
    ratio="compress";
    size="12,5";
    node [fontname="Helvetica", fontsize=10, style="filled,rounded", shape=box, penwidth=1.2, margin="0.12,0.06"];
    edge [fontname="Helvetica", fontsize=9, color="#555555", penwidth=1.2];

    // ── Input ──
    entities [label="__Entity__\nNodes", fillcolor="#E0F2F1", color="#00897B"];

    // ── Step 1: Embedding ──
    subgraph cluster_step1 {
        label="Step 1: Embedding";
        fontname="Helvetica Bold";
        fontsize=10;
        style="dashed,rounded";
        color="#1E88E5";
        bgcolor="#E3F2FD";
        margin=12;

        embed [label="multilingual-e5-large\n(CUDA)", fillcolor="#90CAF9", color="#1E88E5"];
        vec [label="1024-dim\nVector", fillcolor="#BBDEFB", color="#1E88E5"];
        embed -> vec;
    }

    // ── Step 2: Community Detection ──
    subgraph cluster_step2 {
        label="Step 2: Community Detection";
        fontname="Helvetica Bold";
        fontsize=10;
        style="dashed,rounded";
        color="#7E57C2";
        bgcolor="#F3E5F5";
        margin=12;

        knn [label="KNN\ncosine sim >= 0.95", fillcolor="#CE93D8", color="#7E57C2"];
        wcc [label="WCC\ncommunity ID", fillcolor="#E1BEE7", color="#7E57C2"];
        knn -> wcc;
    }

    // ── Step 3: Entity Resolution ──
    subgraph cluster_step3 {
        label="Step 3: Entity Resolution";
        fontname="Helvetica Bold";
        fontsize=10;
        style="dashed,rounded";
        color="#E65100";
        bgcolor="#FFF3E0";
        margin=12;

        candidates [label="Candidate Filter\nedit dist <= 3", fillcolor="#FFCC80", color="#E65100"];
        gemini_res [label="Gemini\nStructured Output", fillcolor="#FFE0B2", color="#E65100"];
        merge [label="APOC\nmergeNodes", fillcolor="#FFE0B2", color="#E65100"];
        candidates -> gemini_res -> merge;
    }

    // ── Output ──
    output [label="Refined\nKnowledge\nGraph", fillcolor="#E8F5E9", color="#43A047", shape=doubleoctagon];

    // ── Edges ──
    entities -> embed;
    vec -> knn;
    wcc -> candidates;
    merge -> output;
}
